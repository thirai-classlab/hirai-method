# ================================================================
# ClassLab. Weekly News 投稿スキル - 環境変数テンプレート
# ================================================================
# コピーして .env を作成し、実値を入れる（.env は gitignore 対象）

# ---------------------------------------------------------------
# Supabase（本リポと同一プロジェクト: dlitnmseevxynwgpltcl）
# ---------------------------------------------------------------
SUPABASE_URL=https://dlitnmseevxynwgpltcl.supabase.co
SUPABASE_ANON_KEY=
# service_role_key は投稿スキル専用。本リポには置かない。RLS をバイパスして INSERT/UPDATE 可能
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Vercel AI Gateway（LLM: Haiku / Sonnet 経由）
# ---------------------------------------------------------------
# API Key 方式 or OIDC 認証のいずれか
AI_GATEWAY_API_KEY=
# OIDC の場合は VERCEL_OIDC_TOKEN を使用（ローカル実行時は API Key 推奨）

# ---------------------------------------------------------------
# Embedding（text-embedding-3-large / 1024 次元）
# ---------------------------------------------------------------
# AI Gateway 経由で呼び出しているため OPENAI_API_KEY は不要。
# AI_GATEWAY_API_KEY があれば `openai/text-embedding-3-large` を呼べる。

# ---------------------------------------------------------------
# サイト側 ISR revalidate
# ---------------------------------------------------------------
SITE_URL=https://classlab-weekly-news.vercel.app
# /api/revalidate エンドポイントで検証するシークレット
REVALIDATE_SECRET=

# ---------------------------------------------------------------
# Phase 11 W1.D-2: --via-api モード（並行運用パス）
# ---------------------------------------------------------------
# --via-api フラグ使用時は本体 INSERT を POST /api/ingest 経由に切り替える。
# デフォルト OFF（従来の Supabase 直接 INSERT が使われる）。
#
# INGEST_SECRET: 本リポ classlab-weekly-news の INGEST_SECRET と同値
INGEST_SECRET=
# BATCH_SECRET: 本リポ classlab-weekly-news の BATCH_SECRET と同値（--publish フラグ / publish CLI 用）
BATCH_SECRET=
#
# CLASSLAB_WEEKLY_NEWS_API_URL: 任意。未指定時は Production URL を使用
#   (デフォルト: https://classlab-weekly-news.vercel.app)
# CLASSLAB_WEEKLY_NEWS_API_URL=https://classlab-weekly-news.vercel.app
#
# 制限事項（Wave 11.2 完了まで）:
#   --via-api ON 時、embedding 生成・関連紐付け・本文リンク挿入は SKIP される。
#   Wave 11.2 (Augment Edge Function) デプロイ後に自動処理される想定。
#   それまでは --via-api を外してデフォルトパスを使うこと。

# ---------------------------------------------------------------
# AWS S3 + CloudFront（markdown 画像の自動アップロード）
# ---------------------------------------------------------------
# 本リポ classlab-weekly-news と同じ値。IAM user は
# `classlab-weekly-news-uploader` を利用する。
# AWS_* が欠けている場合、画像アップロードはスキップされる（markdown 内の
# http(s):// 参照はそのまま残る）。
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=classlab-weekly-news-content
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLOUDFRONT_DOMAIN=d2f75plg0t6qwk.cloudfront.net
CLOUDFRONT_DISTRIBUTION_ID=E19HM38I4166EC

# ---------------------------------------------------------------
# Task #32: thumbnail-patterns.json 参照用（任意）
# ---------------------------------------------------------------
# サムネイル自動生成 (output/gen-news-thumbnail.mjs) を呼ぶための、
# classlab-weekly-news リポジトリの絶対パス。
# 未設定時は --no-thumbnail-hearing 相当の挙動 (frontmatter.thumbnail
# 指定済みの投稿のみ可) になる。
CLASSLAB_WEEKLY_NEWS_DIR=/Users/t.hirai/work/classlab-weekly-news

# ---------------------------------------------------------------
# 動作設定（任意）
# ---------------------------------------------------------------
# LOG_LEVEL=info
# DRY_RUN=false
