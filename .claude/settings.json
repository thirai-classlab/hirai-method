{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$generated": {
    "by": "generate-settings.sh",
    "source": "harness-config.yml + .claude/hooks/dispatcher-manifest.tsv",
    "note": "hooks block is generated; permissions block is manual (transcribed from live). Do not edit hooks by hand — edit the manifest + re-run generate-settings.sh."
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(rm -rf:*)",
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git branch -D:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/rules/**)",
      "Write(./.claude/rules/**)"
    ],
    "allow": [
      "Edit(./.claude/mode.yml)",
      "Write(./.claude/mode.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"Edit|Write\"",
            "timeout": 5,
            "statusMessage": "PreToolUse dispatcher (Edit|Write)"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"Read\"",
            "timeout": 5,
            "statusMessage": "PreToolUse dispatcher (Read)"
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"Grep\"",
            "timeout": 5,
            "statusMessage": "PreToolUse dispatcher (Grep)"
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"Glob\"",
            "timeout": 5,
            "statusMessage": "PreToolUse dispatcher (Glob)"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"Bash\"",
            "timeout": 5,
            "statusMessage": "PreToolUse dispatcher (Bash)"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"Agent|Task\"",
            "timeout": 5,
            "statusMessage": "PreToolUse dispatcher (Agent|Task)"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-tool-use-dispatcher.sh \"*\"",
            "timeout": 3,
            "statusMessage": "PreToolUse dispatcher (*)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-dispatcher.sh \"Agent|Task\"",
            "timeout": 5,
            "statusMessage": "PostToolUse dispatcher (Agent|Task)"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-dispatcher.sh \"Edit|Write\"",
            "timeout": 90,
            "statusMessage": "PostToolUse dispatcher (Edit|Write)"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/post-tool-use-dispatcher.sh \"*\"",
            "timeout": 3,
            "statusMessage": "PostToolUse dispatcher (*)"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/notification-dispatcher.sh",
            "timeout": 5,
            "statusMessage": "Notification dispatcher (*)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-dispatcher.sh",
            "timeout": 5,
            "statusMessage": "Stop dispatcher (*)"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-stop-dispatcher.sh",
            "timeout": 10,
            "statusMessage": "SubagentStop dispatcher (*)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-dispatcher.sh",
            "timeout": 15,
            "statusMessage": "SessionStart dispatcher (*)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/user-prompt-submit-dispatcher.sh",
            "timeout": 5,
            "statusMessage": "UserPromptSubmit dispatcher (*)"
          }
        ]
      }
    ]
  }
}
