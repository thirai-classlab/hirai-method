#!/usr/bin/env bash
# .githooks/pre-commit — hirai-method fast smoke gate (task-92 P2-1/I3)
#
# 役割:
#   Fast smoke curated set (実測 ≒ 2.4s、予算 < 3s) を commit 境界で機械実行し、
#   FAIL で BLOCK (exit 1)。feature OFF / smoke 不在 / config-loader 不在は
#   fail-open で pass (§3.2 fail-open 2 層契約)。
#
# curated set (4 本、2026-07-06 dogfood 実測):
#   1. bash -n .claude/hooks/*.sh + .claude/scripts/*.sh + install.sh  (0.08s)
#   2. .claude/tests/enforcement-mismatch-smoke.sh                     (0.58s)
#   3. .claude/tests/harness-config-local-smoke.sh                     (1.66s)
#   4. .claude/tests/common-rules-import-smoke.sh                      (0.06s)
#
# bypass:
#   HC_PRECOMMIT_SKIP=1 git commit ...              # 1-shot 明示 skip
#   git commit --no-verify                          # git native skip
#   HC_FEATURE_PRE_COMMIT_SMOKE_ENABLED=false       # feature OFF (silent pass)
#
# migration path (task-94 P2-3、draft §3.2 R1 契約):
#   本 file 内 _pc_emit_block / _pc_emit_warn / _pc_emit_info helper は
#   task-94 で .claude/hooks/lib/block-message.sh へ 1:1 移行予定
#   (prefix `_pc_` を除去して同 4 引数 signature を保持、
#   `sed 's/_pc_emit_/emit_/g'` で機械置換可能)。
#
# fail-open 契約 (feedback_set_e_in_sourced_libs、CommonRules Critical Lessons):
#   file-top に set -euo pipefail を書かない (caller shell への leak / SIGPIPE
#   exit 141 サイレント死回避)。subshell 関数 _run_fast_smokes() ( set -euo
#   pipefail; ... ) のみ strict 局所化。
#
# 設計 SSoT: docs/draft/install-pre-commit-distribute.md §3.2 / §3.3 / §4.3

set -u

# --- git worktree / submodule 対応: repo root へ固定 (§4.1 リスク緩和) ---
_pc_repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$_pc_repo_root" || exit 0   # cd 失敗は fail-open (pass)

# --- 暫定 helper (task-94 lib SSoT へ 1:1 migration 予定) ---
# 4 args: <why> <fix_one_liner> <bypass_env> <docs_link>
# stderr 出力順: why: / fix: / silence: / docs:
# (empty string を渡すと該当行 skip、null 行を避けるため)
_pc_emit() {
  _pc_sev="$1"; _pc_why="$2"; _pc_fix="$3"; _pc_silence="$4"; _pc_docs="$5"
  {
    printf '[pre-commit %s] why: %s\n' "$_pc_sev" "$_pc_why"
    [ -n "$_pc_fix" ]     && printf '[pre-commit %s] fix: %s\n'     "$_pc_sev" "$_pc_fix"
    [ -n "$_pc_silence" ] && printf '[pre-commit %s] silence: %s\n' "$_pc_sev" "$_pc_silence"
    [ -n "$_pc_docs" ]    && printf '[pre-commit %s] docs: %s\n'    "$_pc_sev" "$_pc_docs"
  } >&2
}
_pc_emit_block() { _pc_emit BLOCK "$@"; }
_pc_emit_warn()  { _pc_emit WARN  "$@"; }
_pc_emit_info()  { _pc_emit INFO  "$@"; }

# --- config-loader.sh 経路の feature toggle 参照 (fail-open) ---
if [ -f "$_pc_repo_root/.claude/hooks/lib/config-loader.sh" ]; then
  # shellcheck disable=SC1091
  source "$_pc_repo_root/.claude/hooks/lib/config-loader.sh" 2>/dev/null || true
else
  # config-loader 不在 = bootstrap 途中の可能性 → fail-open で pass (BLOCK しない)
  _pc_emit_warn \
    ".claude/hooks/lib/config-loader.sh 不在で feature toggle が読めない (bootstrap 中の可能性、fail-open pass)" \
    "" \
    "" \
    "docs/draft/install-pre-commit-distribute.md"
  exit 0
fi

# --- feature toggle: OFF なら silent pass ---
# (is_feature_enabled 未定義時も安全側で pass、config-loader load 失敗の fallback)
if command -v is_feature_enabled >/dev/null 2>&1 \
   && ! is_feature_enabled pre_commit_smoke; then
  exit 0
fi

# --- 1-shot bypass env (HC_PRECOMMIT_SKIP=1) ---
if [ "${HC_PRECOMMIT_SKIP:-0}" = "1" ]; then
  _pc_emit_info \
    "HC_PRECOMMIT_SKIP=1 検出、fast smoke skip (1 回 bypass)" \
    "" \
    "" \
    "docs/draft/install-pre-commit-distribute.md"
  exit 0
fi

# --- fast smoke curated set (subshell 局所化で set -euo pipefail leak 防止) ---
# smoke 不在は WARN + skip (fail-open、set -e 影響外の printf のみ)
# smoke exit != 0 は set -e で subshell 全体を非 0 exit → 呼出側で BLOCK
_run_fast_smokes() (
  set -euo pipefail
  # (1) bash -n bulk (syntax error 即検出、実測 0.08s)
  if compgen -G ".claude/hooks/*.sh" >/dev/null 2>&1; then
    for _f in .claude/hooks/*.sh; do bash -n "$_f"; done
  fi
  if compgen -G ".claude/scripts/*.sh" >/dev/null 2>&1; then
    for _f in .claude/scripts/*.sh; do bash -n "$_f"; done
  fi
  [ -f install.sh ] && bash -n install.sh
  # (2)-(4) curated smokes (順次実行、いずれか FAIL で abort)
  for _smoke in \
    enforcement-mismatch-smoke.sh \
    harness-config-local-smoke.sh \
    common-rules-import-smoke.sh
  do
    if [ -f ".claude/tests/$_smoke" ]; then
      bash ".claude/tests/$_smoke" >/dev/null
    else
      # 不在 smoke は fail-open (WARN のみ、subshell 継続)
      printf '[pre-commit WARN] .claude/tests/%s 不在 (fail-open skip)\n' "$_smoke" >&2
    fi
  done
)

# --- task-94 §4.4: BLOCK direct-write check (raw 直書き BLOCK 検出) ---
# hook で raw BLOCK / exit 2 を書いた場合は lib/block-message.sh source 必須。
# 対象: staged .claude/hooks/*.sh のみ (lib 自身は除外)。
# 誤検知回避: staged file が該当 file である場合のみ check、file が存在しない場合は skip。
# bypass: HC_PRECOMMIT_LIB_BLOCK_CHECK_OFF=1 (1 commit のみ、bypass.log に記録)。
_run_lib_block_check() (
  set -uo pipefail
  # bypass check
  if [ "${HC_PRECOMMIT_LIB_BLOCK_CHECK_OFF:-0}" = "1" ]; then
    return 0
  fi
  # staged .claude/hooks/*.sh のみ対象 (lib 自身は除外)
  local _staged_hooks
  _staged_hooks=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null \
    | grep -E '^\.claude/hooks/[^/]+\.sh$' \
    || true)
  [ -z "$_staged_hooks" ] && return 0

  local _violators=""
  local _f
  while IFS= read -r _f; do
    [ -z "$_f" ] && continue
    [ ! -f "$_f" ] && continue
    # raw BLOCK 直書き pattern 検出:
    #   - printf.*BLOCK  (stderr / stdout に BLOCK 文字列を直書き)
    #   - cat <<.*EOF (BLOCK / >&2 が同 hook 内)
    #   - jq -n .*decision.*block (JSON stdout 直書き)
    if grep -qE '(printf.*BLOCK|jq -n .*decision.*block)' "$_f" 2>/dev/null; then
      # lib/block-message.sh を source しているか
      if ! grep -q 'lib/block-message.sh' "$_f" 2>/dev/null; then
        _violators="${_violators}${_f}\n"
      fi
    fi
  done <<< "$_staged_hooks"

  if [ -n "$_violators" ]; then
    _pc_emit_block \
      "hook で BLOCK message / JSON decision:block を lib 未経由で raw 直書き検出: $(printf '%b' "$_violators" | tr '\n' ' ')" \
      "対象 hook で 'source .../lib/block-message.sh' + emit_block_pretool / emit_block_stop / emit_block_subagent API へ置換" \
      "HC_PRECOMMIT_LIB_BLOCK_CHECK_OFF=1 git commit ...  (1 commit のみ、bypass.log 記録)" \
      "docs/draft/lib-block-message-4args.md §4.4"
    return 1
  fi
  return 0
)

# --- 予算 (default 3s、yml `pre_commit_smoke_budget_sec` → env HC_PRE_COMMIT_SMOKE_BUDGET_SEC) ---
_pc_budget="${HC_PRE_COMMIT_SMOKE_BUDGET_SEC:-3}"

# --- 実測開始 (bash 組込 SECONDS で秒単位計測) ---
SECONDS=0
if ! _run_fast_smokes; then
  _pc_elapsed=$SECONDS
  _pc_emit_block \
    "fast smoke curated set FAIL (bash -n / enforcement-mismatch / harness-config-local / common-rules-import のいずれか、経過 ${_pc_elapsed}s)" \
    "bash .claude/tests/enforcement-mismatch-smoke.sh 等を個別実行し失敗内容を確認 → 修正後 git commit を再試行" \
    "HC_PRECOMMIT_SKIP=1 git commit ...  または  git commit --no-verify  (1 回 skip、恒久 OFF は HC_FEATURE_PRE_COMMIT_SMOKE_ENABLED=false)" \
    "docs/draft/install-pre-commit-distribute.md"
  exit 1
fi
_pc_elapsed=$SECONDS

# --- task-94 §4.4: BLOCK direct-write check (lib/block-message.sh 経由必須) ---
# fast smoke PASS 後に実行。違反検出で BLOCK (exit 1)。
if ! _run_lib_block_check; then
  exit 1
fi

# --- task-100 §4.5: yml triplet policy (key + consumer + smoke 同 commit BLOCK) ---
# harness-config.yml diff から新規追加 key を抽出し、consumer (hook / script /
# template で該当 key を Read) + smoke (.claude/tests/*-smoke.sh で該当 key を
# 試験) の存在を grep で検証。三点揃わない状態の commit を BLOCK。
#
# 対象 pattern (staged +行、既存 modification は対象外):
#   - feature_<name>_enabled: <value>   → 期待 env HC_FEATURE_<NAME>_ENABLED
#   - <scalar_key>: <value>             → 期待 env HC_<KEY> (要 grep hit)
#
# 検出方針:
#   - 追加行 (diff `^+` かつ `^-` 対応行なし) のみ対象
#   - top-level key に限定 (indent 0 のみ、nested block は除外して false positive 削減)
#   - コメント行 (^# / 末尾 `# comment`) はコメント除去してから判定
#
# consumer / smoke 判定:
#   - consumer: .claude/hooks/**/*.sh + .claude/scripts/**/*.sh + .claude/templates/**
#     の中で env 名 or key 名を含む file が 1 つでも存在
#   - smoke: .claude/tests/*-smoke.sh の中で env 名 or key 名を含む file が 1 つでも存在
#
# bypass:
#   HC_FEATURE_YML_TRIPLET_CHECK_ENABLED=false  # config 系統 (yml feature toggle、session 全体 OFF)
#   HC_YML_TRIPLET_CHECK_ENABLED=false          # config 系統 (旧名 alias、後方互換維持)
#   ECC_YML_TRIPLET_OFF=1                       # env 系統 (1 commit のみ)
#   HC_PRECOMMIT_SKIP=1                         # 上位 bypass (fast smoke 前で既に return)
#
# fail-open:
#   - git diff --cached が取得失敗 → skip (BLOCK しない)
#   - harness-config.yml が staged 内に無い → skip
#   - 追加 key 0 件 → skip
_run_yml_triplet_check() (
  set -uo pipefail
  # bypass check (env 系統 / config 系統いずれか OFF なら skip)
  if [ "${ECC_YML_TRIPLET_OFF:-0}" = "1" ]; then
    return 0
  fi
  # feature toggle 正式名 (yml `feature_yml_triplet_check_enabled` に対応、
  # config-loader.sh 経由で HC_FEATURE_YML_TRIPLET_CHECK_ENABLED として export される)
  if [ "${HC_FEATURE_YML_TRIPLET_CHECK_ENABLED:-true}" = "false" ]; then
    return 0
  fi
  # 旧名 alias (後方互換、documentation の bypass hint を維持)
  if [ "${HC_YML_TRIPLET_CHECK_ENABLED:-true}" = "false" ]; then
    return 0
  fi
  # harness-config.yml が staged に含まれるか判定
  local _yml_path=".claude/harness-config.yml"
  local _staged
  _staged=$(git diff --cached --name-only --diff-filter=AM 2>/dev/null || true)
  if [ -z "$_staged" ]; then
    return 0  # diff 取得失敗 or staged 空 → fail-open
  fi
  if ! printf '%s\n' "$_staged" | grep -qxF "$_yml_path"; then
    return 0  # yml 変更なし → skip
  fi
  # 新規追加 key 抽出 (top-level key のみ、コメント除去、既存修正は除外)
  # git diff --cached -U0 -- .claude/harness-config.yml で unified diff (context 0)
  # `+` 行のうち `+++` header を除外し、`<key>: <value>` パターンで top-level key 抽出
  local _diff
  _diff=$(git diff --cached -U0 -- "$_yml_path" 2>/dev/null || true)
  [ -z "$_diff" ] && return 0
  # 追加行から top-level key (indent 0) の new key を抽出
  # pattern: `^+<key>: ...` (key は [a-z_][a-z0-9_]* に限定、feature_* / scalar 両対応)
  # `-<key>: ...` (旧行) 対応がある場合は modification 扱いで除外
  # 実装: awk で hunk 単位に - と + の key set を比較、新規 key のみ抽出
  local _new_keys
  _new_keys=$(printf '%s\n' "$_diff" | awk '
    /^@@/ { in_hunk=1; delete removed; delete added; next }
    !in_hunk { next }
    /^---/ || /^\+\+\+/ { next }
    /^-[a-z_][a-z0-9_]*:/ {
      line=$0; sub(/^-/,"",line); sub(/:.*$/,"",line); removed[line]=1; next
    }
    /^\+[a-z_][a-z0-9_]*:/ {
      line=$0; sub(/^\+/,"",line);
      # コメント行 (末尾 `# ...`) は key 抽出後に無視
      sub(/:.*$/,"",line)
      added[line]=1
      # 次段で removed に無ければ new key
    }
    END {
      for (k in added) {
        if (!(k in removed)) print k
      }
    }
  ' | sort -u)
  [ -z "$_new_keys" ] && return 0  # 新規 top-level key 0 件 → skip

  # 各 key について consumer + smoke grep
  local _violators=""
  local _key _env_name _hint _found_consumer _found_smoke
  while IFS= read -r _key; do
    [ -z "$_key" ] && continue
    # env 名派生: feature_*_enabled → HC_FEATURE_<NAME>_ENABLED, その他 → HC_<KEY>
    local _upper
    _upper=$(printf '%s' "$_key" | tr '[:lower:]' '[:upper:]')
    _env_name="HC_${_upper}"
    # consumer 検索: hooks/ + scripts/ + templates/ で env 名 or key 名を含む file
    _found_consumer=""
    if compgen -G ".claude/hooks/*.sh" >/dev/null 2>&1 \
       || compgen -G ".claude/scripts/*.sh" >/dev/null 2>&1 \
       || [ -d ".claude/templates" ]; then
      # grep -l で file 名 list、非 0 (不在) は無視
      _found_consumer=$(
        {
          [ -d ".claude/hooks" ] && grep -rlE "(${_env_name}|${_key})" .claude/hooks 2>/dev/null || true
          [ -d ".claude/scripts" ] && grep -rlE "(${_env_name}|${_key})" .claude/scripts 2>/dev/null || true
          [ -d ".claude/templates" ] && grep -rlE "(${_env_name}|${_key})" .claude/templates 2>/dev/null || true
          # config-loader.sh 自身は consumer とみなさない (定義のみ) → path 除外
        } | grep -v -E '^(\.claude/hooks/lib/config-loader\.sh|\.claude/scripts/lib/hc-config-metadata\.sh)$' || true
      )
    fi
    # smoke 検索: .claude/tests/*-smoke.sh
    _found_smoke=""
    if compgen -G ".claude/tests/*-smoke.sh" >/dev/null 2>&1; then
      _found_smoke=$(grep -lE "(${_env_name}|${_key})" .claude/tests/*-smoke.sh 2>/dev/null || true)
    fi
    # 判定
    if [ -z "$_found_consumer" ] && [ -z "$_found_smoke" ]; then
      _violators="${_violators}${_key} (consumer + smoke 不在)\n"
    elif [ -z "$_found_consumer" ]; then
      _violators="${_violators}${_key} (consumer 不在)\n"
    elif [ -z "$_found_smoke" ]; then
      _violators="${_violators}${_key} (smoke 不在)\n"
    fi
  done <<< "$_new_keys"

  if [ -n "$_violators" ]; then
    _pc_emit_block \
      "harness-config.yml に新規 key を追加したが consumer/smoke が同 commit に不在: $(printf '%b' "$_violators" | tr '\n' ' ')" \
      "3 点セットを同 commit に含める: (1) yml の key 定義 (2) 該当 key を Read する hook/script/template (consumer) (3) key を試験する .claude/tests/*-smoke.sh (smoke)" \
      "HC_FEATURE_YML_TRIPLET_CHECK_ENABLED=false git commit ...  または  ECC_YML_TRIPLET_OFF=1 git commit ...  (bypass 時は理由を task/docs に記録、旧名 HC_YML_TRIPLET_CHECK_ENABLED=false も後方互換で有効)" \
      ".claude/rules/development-process.md §「I7 triplet」+ docs/draft/install-immediately-usable-redesign-20260618.md §3 I7"
    return 1
  fi
  return 0
)

if ! _run_yml_triplet_check; then
  exit 1
fi

# --- 予算超過は WARN のみ (BLOCK しない、smoke curated set 見直し signal) ---
if [ "$_pc_elapsed" -gt "$_pc_budget" ]; then
  _pc_emit_warn \
    "fast smoke 予算超過 (${_pc_elapsed}s > ${_pc_budget}s)、curated set の見直し推奨" \
    "smoke 追加時は pre_commit_smoke_budget_sec を再評価、CI 側 (task-93) へ回送を検討" \
    "HC_PRE_COMMIT_SMOKE_BUDGET_SEC=<n> で env 上書き可 / harness-config.yml で永続変更" \
    "docs/draft/install-pre-commit-distribute.md"
fi

exit 0
